{
  "name": "Searchlight",
  "notes": "The inverse of every animation in the flat set: instead of drawing light, layer 1 removes it. A warm strip is lit end to end, and an ERASE layer punches a soft moving hole through it -- `acc *= (1 - src.alpha)`, so the erasing layer's colour is irrelevant and only its density matters. Add a third layer above this one and it draws into the hole. Note the ordering: erase is order 1, so it cuts what is already there; at order 0 it would have nothing to cut and the patch would look like a plain fill.",
  "layers": {
    "0": {
      "emitter": {
        "type": "block",
        "params": {
          "level": 1,
          "softness": 0
        }
      },
      "colour": {
        "index": "position",
        "palette": {
          "entries": [
            "ff6000",
            "ffb040",
            "ff6000"
          ]
        }
      },
      "blend": "over",
      "opacity": 1,
      "order": 0
    },
    "1": {
      "emitter": {
        "type": "line",
        "params": {
          "centre": 0.5,
          "length": 0.02,
          "softness": 0
        }
      },
      "colour": {
        "index": "u",
        "palette": {
          "entries": [
            "ffffff"
          ]
        }
      },
      "blend": "erase",
      "opacity": 1,
      "order": 1
    }
  },
  "modulators": {
    "0": {
      "type": "lfo",
      "wave": "triangle",
      "params": {
        "rate": 0.02
      }
    },
    "1": {
      "type": "macro",
      "name": "speed",
      "label": "Speed",
      "params": {
        "knob": 0.12162162162162164
      }
    },
    "2": {
      "type": "macro",
      "name": "beam",
      "label": "Beam Width",
      "params": {
        "knob": 0.24137931034482762
      }
    },
    "3": {
      "type": "macro",
      "name": "edge",
      "label": "Edge",
      "params": {
        "knob": 0.25
      }
    }
  },
  "matrix": [
    {
      "src": 0,
      "dst": "L1.emitter.centre",
      "depth": 0.45,
      "bipolar": true
    },
    {
      "src": "speed",
      "dst": "M0.rate",
      "depth": 1.48,
      "bipolar": true
    },
    {
      "src": "beam",
      "dst": "L1.emitter.length",
      "depth": 0.58,
      "bipolar": true
    },
    {
      "src": "edge",
      "dst": "L1.emitter.softness",
      "depth": 0.4,
      "bipolar": true
    }
  ],
  "surface": [
    {
      "key": "speed",
      "label": "Speed",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 12.1622,
      "target": "M1.knob",
      "lo": 0,
      "hi": 1
    },
    {
      "key": "beam",
      "label": "Beam Width",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 24.1379,
      "target": "M2.knob",
      "lo": 0,
      "hi": 1
    },
    {
      "key": "edge",
      "label": "Edge",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 25,
      "target": "M3.knob",
      "lo": 0,
      "hi": 1
    }
  ]
}
