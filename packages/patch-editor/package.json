{
  "name": "@illumigoon/patch-editor",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "The patch editor, inside the Illumigoon app (LIFE-1885).",
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "default": "./src/index.tsx"
    },
    "./engine": "./src/engine/generated/engine.mjs",
    "./sidecar": "./server/discover.mjs",
    "./phone": {
      "types": "./src/phone/phone-types.d.ts",
      "default": "./src/phone/index.ts"
    },
    "./wire": "./src/device/wire.ts",
    "./library": "./src/library/shared.ts"
  },
  "dependencies": {
    "@illumigoon/led-tape": "*",
    "bonjour-service": "^1.3.0",
    "idb-keyval": "^6.2.2",
    "path-browserify": "^1.0.1",
    "ws": "^8.21.3"
  },
  "scripts": {
    "lint": "npm run lint:types && npm run lint:code && npm run lint:complexity && npm run lint:layers && npm run lint:dupes && npm run lint:rules",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "lint:code": "oxlint --deny-warnings src server",
    "lint:complexity": "biome lint --max-diagnostics=none",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:rules": "node scripts/edit-rules.mjs",
    "lint:dupes": "jscpd --min-tokens 50 --min-lines 5 --threshold 0 --exitCode 1 --reporters console --format typescript,tsx --ignore \"**/generated/**\" src server"
  }
}
