{
  "name": "illumigoon-remote",
  "private": true,
  "version": "0.0.1",
  "description": "iPhone app to control the lights (LIFE-1845).",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capgo/capacitor-updater": "8.54.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@mhaberler/capacitor-zeroconf-nsd": "5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@capacitor/cli": "8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "^18.7.0",
    "jscpd": "^4.3.0",
    "knip": "^6.44.0",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "node scripts/lint/all.mjs",
    "lint:types": "tsc --noEmit",
    "lint:code": "oxlint --deny-warnings src scripts",
    "lint:complexity": "biome lint --max-diagnostics=none",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:dupes": "jscpd --min-tokens 50 --min-lines 5 --threshold 0 --exitCode 1 --reporters console --format typescript,tsx --ignore \"**/looks/engine/**\" src",
    "lint:unused": "knip",
    "lint:rules": "node scripts/lint/rules.mjs"
  },
  "type": "module"
}
