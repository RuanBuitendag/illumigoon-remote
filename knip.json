{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/lint/*.mjs",
        "electron-builder.config.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.mjs",
        "electron/**/*.mjs"
      ]
    },
    "packages/patch-editor": {
      "entry": [
        "src/domain/rules.ts",
        "src/domain/statehash.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "server/**/*.mjs",
        "!src/engine/generated/**"
      ]
    }
  }
}
