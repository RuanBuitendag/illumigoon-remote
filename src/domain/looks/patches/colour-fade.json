          "paletteSpan": 0.08
        },
        "palette": {
          "entries": [
            "ff0040",
            "ff8000",
            "ffe000",
            "00e080",
            "0080ff",
            "8000ff"
          ],
          "params": {}
        },
        "wrap": true
