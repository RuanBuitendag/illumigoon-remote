{
  "name": "Ember Drift",
  "notes": "Embers under a haze. Layer 0 is a slow noise field read through an ember palette -- the heat is entirely in the colour stage, which is the point: a fire look is a palette over a field, not an emitter of its own. Layer 1 is a second, finer noise field with an all-black palette blended MULTIPLY at low opacity, which mottles the embers with drifting shadow -- the premultiplied multiply is (1 - alpha) at a black source, so layer opacity sets exactly how dark the darkest patch gets and nothing else. A perlin-wave LFO wanders layer 0's evolve rate so the burn is never quite steady. The two macros are the performance surface: nothing in the matrix touches what they touch, which is the rule -- a matrix row reseeds its target from the base captured at load and would overwrite a macro every frame.",
  "layers": {
    "0": {
      "emitter": {
        "type": "perlin",
        "params": {
          "scale": 2.4,
          "evolve": 0.22
        }
      },
      "colour": {
        "index": "u",
        "palette": {
          "entries": [
            "000000",
            "3c0800",
            "b42800",
            "ff8c20",
            "ffe8b0"
          ],
          "params": {
            "value": 0.2
          }
        }
      },
      "blend": "add",
      "opacity": 1,
      "order": 0
    },
    "1": {
      "emitter": {
        "type": "perlin",
        "params": {
          "scale": 6,
          "time": 0
        }
      },
      "colour": {
        "index": "u",
        "palette": {
          "entries": [
            "000000"
          ]
        }
      },
      "blend": "multiply",
      "opacity": 0,
      "order": 1
    }
  },
  "modulators": {
    "0": {
      "type": "lfo",
      "wave": "sine",
      "params": {
        "rate": 0.07
      }
    },
    "1": {
      "type": "lfo",
      "wave": "perlin",
      "params": {
        "rate": 0.6
      }
    },
    "2": {
      "type": "macro",
      "name": "heat",
      "label": "Heat",
      "params": {
        "knob": 0.4444444444444445
      }
    },
    "3": {
      "type": "macro",
      "name": "haze",
      "label": "Haze",
      "params": {
        "knob": 0.43749999999999994
      }
    }
  },
  "matrix": [
    {
      "src": 0,
      "dst": "L1.emitter.time",
      "depth": 8,
      "bipolar": true
    },
    {
      "src": 1,
      "dst": "L0.emitter.evolve",
      "depth": 0.5,
      "bipolar": true
    },
    {
      "src": 0,
      "dst": "L1.emitter.offset",
      "depth": 1.5,
      "bipolar": true
    },
    {
      "src": "heat",
      "dst": "L0.palette.value",
      "depth": 1.8,
      "bipolar": true
    },
    {
      "src": "haze",
      "dst": "L1.layer.opacity",
      "depth": 0.8,
      "bipolar": true
    }
  ],
  "surface": [
    {
      "key": "heat",
      "label": "Heat",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 44.4444,
      "target": "M2.knob",
      "lo": 0,
      "hi": 1
    },
    {
      "key": "haze",
      "label": "Haze",
      "type": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 43.75,
      "target": "M3.knob",
      "lo": 0,
      "hi": 1
    }
  ]
}
